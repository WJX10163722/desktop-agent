# 复制本文件为 .env 后填入真实 Key，.env 不要入库
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：OpenAI 兼容端点
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 以下全部可留空，留空用默认值 ----

# 模型请求失败重试次数（网络抖动/429/5xx 时退避重试；4xx 不重试）
# AGENT_MAX_RETRIES=3

# 请求超时（秒）
# AGENT_TIMEOUT=120

# 单次任务最大轮数（防止模型反复调工具停不下来）
# AGENT_MAX_TURNS=30

# 上下文压缩预算（字符）：历史超过这个长度，中段自动折成摘要
# AGENT_CONTEXT_BUDGET=24000

# 压缩时保留最近多少条消息
# AGENT_KEEP_RECENT=8

# 置 0 关闭会话持久化（默认开，历史存 sessions/last.json）
# AGENT_PERSIST=1

# MCP 外部工具开关（默认开；置 0 只用本地四工具）
# AGENT_MCP=1
